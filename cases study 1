<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SIT Nagpur Department</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:linear-gradient(rgba(0,0,0,0.65),rgba(0,0,0,0.65)),
    url("sit.jpg");
    background-size:cover;
    background-position:center;
    color:white;
}

header{
    background:#002147;
    text-align:center;
    padding:25px;
}

header h1{
    font-size:40px;
}

header h2{
    margin-top:10px;
    font-weight:normal;
}

.container{
    width:85%;
    margin:auto;
    padding:40px;
}

.card{
    background:rgba(255,255,255,0.12);
    backdrop-filter:blur(5px);
    padding:30px;
    border-radius:12px;
    margin-bottom:30px;
}

.card h2{
    color:#FFD700;
    margin-bottom:15px;
}

.card p{
    line-height:30px;
    font-size:18px;
}

button{
    margin-top:20px;
    padding:12px 25px;
    background:#ff9800;
    border:none;
    color:white;
    font-size:18px;
    border-radius:8px;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#ff5722;
    transform:scale(1.05);
}

#student{
    display:none;
}

table{
    width:100%;
    border-collapse:collapse;
    margin-top:20px;
}

table,tr,td,th{
    border:1px solid white;
    padding:12px;
    text-align:left;
}

th{
    background:#003366;
}

footer{
    background:#002147;
    text-align:center;
    padding:15px;
    margin-top:30px;
}
</style>

