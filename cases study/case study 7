<script>

/* =====================================
   ELEMENTS
===================================== */

const form =
document.getElementById("registrationForm");

const logContainer =
document.getElementById("logContainer");

const successMessage =
document.getElementById("successMessage");



/* =====================================
   EVENT LOG
===================================== */

function logEvent(eventName,fieldName=""){

const time =
new Date().toLocaleTimeString();

const entry =
document.createElement("div");

entry.className =
"log-entry";

entry.textContent =
`[${time}] ${eventName}
${fieldName ? " → " + fieldName : ""}`;

logContainer.insertBefore(
entry,
logContainer.firstChild
);


/* Keep latest 8 events */

while(
logContainer.children.length > 8
){

logContainer.removeChild(
logContainer.lastChild
);

}

}



/* =====================================
   EMAIL VALIDATION
===================================== */

function validateEmail(email){

const pattern =
/^[^\s@]+@[^\s@]+\.[^\s@]+$/;

return pattern.test(email);

}



/* =====================================
   PHONE VALIDATION
===================================== */

function validatePhone(phone){

const digits =
phone.replace(/\D/g,"");

return digits.length === 10;

}



/* =====================================
   PASSWORD VALIDATION
===================================== */

function validatePassword(password){

const checks = {

length:
password.length >= 8,

lowercase:
/[a-z]/.test(password),

uppercase:
/[A-Z]/.test(password),

number:
/\d/.test(password)

};


updateRequirement(
"req-length",
checks.length
);

updateRequirement(
"req-lowercase",
checks.lowercase
);

updateRequirement(
"req-uppercase",
checks.uppercase
);

updateRequirement(
"req-number",
checks.number
);


return (
checks.length &&
checks.lowercase &&
checks.uppercase &&
checks.number
);

}



/* PASSWORD REQUIREMENT DISPLAY */

function updateRequirement(id,met){

const element =
document.getElementById(id);

let text =
element.textContent.substring(2);


if(met){

element.className =
"requirement met";

element.textContent =
"✅ " + text;

}

else{

element.className =
"requirement not-met";

element.textContent =
"⚫ " + text;

}

}



/* =====================================
   ERROR / SUCCESS DISPLAY
===================================== */

function showError(id,show=true){

const field =
document.getElementById(id);

const error =
document.getElementById(
id + "Error"
);


if(show){

field.classList.add("error");

field.classList.remove("success");

if(error)
error.classList.add("show");

}

else{

field.classList.remove("error");

field.classList.add("success");

if(error)
error.classList.remove("show");

}

}



/* =====================================
   VALIDATE INDIVIDUAL FIELD
===================================== */

function validateField(id){

const field =
document.getElementById(id);

const value =
field.value.trim();

let valid = true;


switch(id){


case "firstName":

case "lastName":

valid =
value.length > 0;

break;



case "email":

valid =
validateEmail(value);

break;



case "phone":

valid =
validatePhone(value);

break;



case "password":

valid =
validatePassword(value);

break;



case "confirmPassword":

const password =
document
.getElementById("password")
.value;

valid =
value !== "" &&
value === password;

break;



case "country":

valid =
value !== "";

break;



case "age":

const age =
Number(value);

valid =
value === "" ||
(age >= 1 && age <= 120);

break;

}


showError(id,!valid);

return valid;

}



/* =====================================
   FOCUS / BLUR / CHANGE EVENTS
===================================== */

const inputs =
form.querySelectorAll(
"input, select, textarea"
);


inputs.forEach(input => {


/* FOCUS */

input.addEventListener(
"focus",
function(){

logEvent(
"🎯 Focus Event",
this.name || this.id
);

}
);


/* BLUR */

input.addEventListener(
"blur",
function(){

logEvent(
"👋 Blur Event",
this.name || this.id
);

validateField(this.id);

}
);


/* CHANGE */

input.addEventListener(
"change",
function(){

logEvent(
"🔄 Change Event",
this.name || this.id
);

}
);


/* INPUT */

input.addEventListener(
"input",
function(){

if(this.id === "password"){

validatePassword(
this.value
);

}

}
);


});



/* =====================================
   BIO CHARACTER COUNTER
===================================== */

const bio =
document.getElementById("bio");

const charCount =
document.getElementById("charCount");


bio.addEventListener(
"input",
function(){

const length =
this.value.length;

charCount.textContent =
`${length} / 200 characters`;

charCount.classList.remove(
"warning",
"danger"
);


if(length >= 180){

charCount.classList.add(
"danger"
);

}

else if(length >= 150){

charCount.classList.add(
"warning"
);

}

}
);



/* =====================================
   FORM SUBMISSION
===================================== */

form.addEventListener(
"submit",
function(event){

event.preventDefault();

logEvent(
"📨 Submit Event"
);


const requiredFields = [

"firstName",
"lastName",
"email",
"phone",
"password",
"confirmPassword",
"country"

];


let validForm = true;


requiredFields.forEach(
id => {

if(!validateField(id)){

validForm = false;

}

}
);


/* AGE */

if(
document.getElementById("age").value !== "" &&
!validateField("age")
){

validForm = false;

}


/* SUCCESS */

if(validForm){

successMessage
.classList.add("show");

logEvent(
"✅ Success",
"Form validated"
);


successMessage.scrollIntoView({
behavior:"smooth",
block:"center"
});


setTimeout(
()=>{

successMessage
.classList.remove("show");

},
5000
);

}

else{

logEvent(
"❌ Validation Error"
);

alert(
"Please correct the highlighted fields before submitting."
);

}

}
);



/* =====================================
   RESET EVENT
===================================== */

form.addEventListener(
"reset",
function(){

logEvent(
"🔄 Reset Event"
);

successMessage
.classList.remove("show");


inputs.forEach(
input => {

input.classList.remove(
"error",
"success"
);

}
);


document
.querySelectorAll(
".error-message"
)
.forEach(
message =>
message.classList.remove("show")
);


setTimeout(
()=>{

charCount.textContent =
"0 / 200 characters";

},
50
);

}
);



/* =====================================
   ENTER KEY EVENT
===================================== */

document.addEventListener(
"keypress",
function(event){

if(
event.key === "Enter" &&
event.target.tagName === "INPUT"
){

logEvent(
"⌨ Enter Key",
event.target.name
);

}

}
);

</script>

