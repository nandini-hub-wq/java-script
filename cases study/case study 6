<script>


/* ================================
   1. REVERSE STRING
================================ */

function reverseString(){

const input =
document.getElementById("inputString").value;


if(input.trim() === ""){

alert("Please enter a string first!");

return;

}


/* split → reverse → join */

const reversed =
input
.split("")
.reverse()
.join("");


document
.getElementById("originalText")
.textContent = input;


document
.getElementById("reversedText")
.textContent = reversed;


document
.getElementById("reverseResult")
.classList.add("show");

}



/* CLEAR REVERSE */

function clearReverse(){

document
.getElementById("inputString")
.value = "";


document
.getElementById("reverseResult")
.classList.remove("show");

}



/* ================================
   2. VOWEL COUNTER
================================ */

function countVowels(){

const text =
document.getElementById("paragraph").value;


if(text.trim() === ""){

alert("Please enter a paragraph first!");

return;

}


/* Find vowels */

const vowels =
text.match(/[aeiouAEIOU]/g) || [];


/* Find consonants */

const consonants =
text.match(
/[bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ]/g
) || [];


/* Characters without spaces */

const totalCharacters =
text.replace(/\s/g,"").length;


/* Display totals */

document
.getElementById("totalVowels")
.textContent = vowels.length;


document
.getElementById("totalConsonants")
.textContent = consonants.length;


document
.getElementById("totalChars")
.textContent = totalCharacters;



/* Individual vowel counter */

const vowelCount = {

a:0,
e:0,
i:0,
o:0,
u:0

};


text
.toLowerCase()
.split("")
.forEach(character => {

if(
vowelCount.hasOwnProperty(character)
){

vowelCount[character]++;

}

});


let details = "";


for(let vowel in vowelCount){

details +=

`<p>
🔹 ${vowel.toUpperCase()}
→ ${vowelCount[vowel]} time(s)
</p>`;

}


document
.getElementById("vowelDetails")
.innerHTML = details;


document
.getElementById("vowelResult")
.classList.add("show");

}



/* CLEAR VOWELS */

function clearVowels(){

document
.getElementById("paragraph")
.value = "";


document
.getElementById("vowelResult")
.classList.remove("show");

}



/* ================================
   3. STRING OPERATIONS
================================ */

function performOperations(){

const str =
document
.getElementById("demoString")
.value;


if(str.trim() === ""){

alert(
"Please enter a string first!"
);

return;

}


/* substring() */

document
.getElementById("substringResult")
.textContent =
str.substring(0,5);



/* indexOf() */

const spaceIndex =
str.indexOf(" ");


document
.getElementById("indexOfResult")
.textContent =

spaceIndex !== -1

? `First space found at index ${spaceIndex}`

: "No spaces found";



/* split() */

const words =
str.split(" ");


document
.getElementById("splitResult")
.textContent =

`${words.length} words → [ ${words.join(", ")} ]`;



/* replace() */

const replaced =
str.replace(/\s/g,"-");


document
.getElementById("replaceResult")
.textContent = replaced;



document
.getElementById("operationsResult")
.classList.add("show");

}



/* ================================
   ENTER KEY SUPPORT
================================ */

document
.getElementById("inputString")
.addEventListener(
"keypress",
function(event){

if(event.key === "Enter"){

reverseString();

}

});

</script>

