<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATM Card PIN Verification</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:linear-gradient(135deg,#0f2027,#203a43,#2c5364);
    display:flex;
    justify-content:center;
    align-items:center;
    height:100vh;
}

.container{
    width:450px;
    background:white;
    padding:35px;
    border-radius:15px;
    box-shadow:0 15px 30px rgba(0,0,0,.4);
    text-align:center;
}

h1{
    color:#003366;
    margin-bottom:10px;
}

h3{
    color:#666;
    margin-bottom:25px;
}

input{
    width:100%;
    padding:12px;
    margin:15px 0;
    font-size:18px;
    border:2px solid #003366;
    border-radius:8px;
    text-align:center;
}

button{
    width:100%;
    padding:12px;
    font-size:18px;
    background:#003366;
    color:white;
    border:none;
    border-radius:8px;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#0055aa;
}

#result{
    margin-top:20px;
    padding:15px;
    border-radius:10px;
    background:#eef5ff;
    font-size:20px;
    font-weight:bold;
}

</style>

<script>

// Function Declaration
function verifyPIN(){

    try{

        let pin=document.getElementById("pin").value.trim();

        if(pin==""){
            throw "Please enter ATM PIN.";
        }

        if(isNaN(pin)){
            throw "PIN should contain numbers only.";
        }

        if(pin.length!=4){
            throw "ATM PIN must contain exactly 4 digits.";
        }

        let reversePin=reverse(pin);

        if(pin===reversePin){

            document.getElementById("result").innerHTML=
            "✅ PIN <b>"+pin+"</b><br><br>It is a <span style='color:green;'>Palindrome PIN</span>";

        }

        else{

            document.getElementById("result").innerHTML=
            "❌ PIN <b>"+pin+"</b><br><br>It is <span style='color:red;'>NOT a Palindrome PIN</span>";

        }

    }

    catch(error){

        alert(error);

    }

}

// Function Expression
const reverse=function(number){

    return number.split("").reverse().join("");

}

</script>

</head>

<body>

<div class="container">

<h1>🏦 ATM Card PIN Verification</h1>

<h3>JavaScript Functions Case Study</h3>

<input
type="password"
id="pin"
maxlength="4"
placeholder="Enter 4-Digit ATM PIN">

<button onclick="verifyPIN()">

Verify PIN

</button>

<div id="result">

Result will appear here.

</div>

</div>

</body>

</html>
