<body>

<div class="container">

    <!-- HEADER -->
    <div class="header">

        <h1>✨ JS Array Study Dashboard</h1>

        <p>
            Interactive JavaScript Array Operations & Iterator Methods
        </p>

        <div class="student-info">
            👩‍💻 Nandini Daharwal &nbsp; | &nbsp;
            PRN: 24070521152
        </div>

    </div>


    <div class="content">

        <div class="description">

            <b>📚 Array Playground:</b>

            Enter numbers and explore JavaScript array operations
            including <b>push(), pop(), shift(), unshift()</b> and
            <b>slice()</b>. The dashboard also demonstrates
            <b>forEach(), map(), filter()</b> and <b>reduce()</b>.

        </div>


        <!-- INPUT AREA -->
        <div class="input-area">

            <div class="input-section">

                <input
                    type="number"
                    id="num-input"
                    placeholder="🔢 Enter a number..."
                >

                <button
                    class="btn-add"
                    onclick="addNumber()">
                    ➕ Push
                </button>

                <button
                    class="btn-pop"
                    onclick="manipulate('pop')">
                    Pop
                </button>

                <button
                    class="btn-shift"
                    onclick="manipulate('shift')">
                    Shift
                </button>

                <button
                    class="btn-unshift"
                    onclick="manipulate('unshift')">
                    Unshift
                </button>

                <button
                    class="btn-slice"
                    onclick="manipulate('slice')">
                    Slice(1,3)
                </button>

                <button
                    class="btn-reset"
                    onclick="clearArray()">
                    🔄 Reset
                </button>

            </div>

