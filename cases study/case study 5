<script>

let userNumbers = [];
let logEntries = [];


/* ================================
   PUSH - ADD NUMBER
================================ */

function addNumber() {

    const input =
        document.getElementById("num-input");

    const value =
        input.value.trim();


    if(value === "") {

        alert("Please enter a number!");

        return;
    }


    const num =
        Number(value);


    userNumbers.push(num);


    addLog(
        `➕ push(${num}) → Added to end`
    );


    input.value = "";

    input.focus();


    updateDashboard();
}



/* ================================
   ARRAY MANIPULATION
================================ */

function manipulate(operation) {


    if(
        userNumbers.length === 0 &&
        operation !== "unshift"
    ) {

        addLog(
            `⚠ ${operation}() → Array is empty`
        );

        updateDashboard();

        return;
    }


    switch(operation) {


        /* POP */

        case "pop":

            const popped =
                userNumbers.pop();

            addLog(
                `❌ pop() → Removed ${popped}`
            );

            break;



        /* SHIFT */

        case "shift":

            const shifted =
                userNumbers.shift();

            addLog(
                `⬅ shift() → Removed ${shifted}`
            );

            break;



        /* UNSHIFT */

        case "unshift":

            const input =
                document.getElementById(
                    "num-input"
                );

            const value =
                input.value.trim();


            if(value === "") {

                alert(
                    "Enter a number first for Unshift!"
                );

                return;
            }


            const num =
                Number(value);


            userNumbers.unshift(num);


            addLog(
                `⬅ unshift(${num}) → Added to beginning`
            );


            input.value = "";

            break;



        /* SLICE */

        case "slice":

            const sliced =
                userNumbers.slice(1,3);


            addLog(
                `✂ slice(1,3) → [${sliced.join(", ")}]`
            );

            break;

    }


    updateDashboard();
}



/* ================================
   RESET
================================ */

function clearArray() {

    userNumbers = [];

    logEntries = [];


    addLog(
        "🔄 Dashboard Reset"
    );


    updateDashboard();
}



/* ================================
   OPERATION LOG
================================ */

function addLog(message) {

    const time =
        new Date()
        .toLocaleTimeString();


    logEntries.unshift(
        `[${time}] ${message}`
    );


    if(logEntries.length > 7) {

        logEntries.pop();

    }
}



/* ================================
   UPDATE DASHBOARD
================================ */

function updateDashboard() {


    const arrayDisplay =
        document.getElementById(
            "array-display"
        );


    const logDisplay =
        document.getElementById(
            "operation-log"
        );


    const caseOutput =
        document.getElementById(
            "case-study-output"
        );


    const methodsOutput =
        document.getElementById(
            "methods-output"
        );


    /* OPERATION LOG */

    logDisplay.innerText =
        logEntries.length
        ? logEntries.join("\n")
        : "No operations yet.";



    /* EMPTY ARRAY */

    if(userNumbers.length === 0) {

        arrayDisplay.innerText =
            "Array is empty.";

        caseOutput.innerText =
            "Waiting for numbers...";

        methodsOutput.innerText =
            "Waiting for numbers...";

        return;
    }



    /* CURRENT ARRAY */

    arrayDisplay.innerText =
        `[ ${userNumbers.join(", ")} ]`;



    /* ================================
       MAXIMUM & MINIMUM USING LOOP
    ================================ */

    let minimum =
        userNumbers[0];

    let maximum =
        userNumbers[0];


    for(
        let i = 1;
        i < userNumbers.length;
        i++
    ) {

        if(
            userNumbers[i] > maximum
        ) {

            maximum =
                userNumbers[i];

        }


        if(
            userNumbers[i] < minimum
        ) {

            minimum =
                userNumbers[i];

        }

    }


    caseOutput.innerHTML =

        `<span class="highlight-max">
        ▲ Maximum Value : ${maximum}
        </span>

        <span class="highlight-min">
        ▼ Minimum Value : ${minimum}
        </span>`;



    /* ================================
       FOREACH
    ================================ */

    let forEachResult = [];


    userNumbers.forEach(
        (number,index) => {

            forEachResult.push(
                `[${index}] = ${number}`
            );

        }
    );



    /* ================================
       MAP
    ================================ */

    const doubled =
        userNumbers.map(
            number => number * 2
        );



    /* ================================
       FILTER
    ================================ */

    const filtered =
        userNumbers.filter(
            number => number > 10
        );



    /* ================================
       REDUCE
    ================================ */

    const sum =
        userNumbers.reduce(
            (total,current) =>
                total + current,
            0
        );



    /* DISPLAY RESULTS */

    methodsOutput.innerText =

`🔹 forEach() :
${forEachResult.join(" | ")}

🔹 map() × 2 :
[ ${doubled.join(", ")} ]

🔹 filter() > 10 :
[ ${filtered.join(", ")} ]

🔹 reduce() Sum :
${sum}`;

}



/* ================================
   ENTER KEY
================================ */

document
.getElementById("num-input")
.addEventListener(
    "keypress",
    function(event) {

        if(event.key === "Enter") {

            addNumber();

        }

    }
);

</script>

