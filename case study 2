<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Shopping Billing Calculator</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,Helvetica,sans-serif;
}

body{
    background:linear-gradient(135deg,#1d2671,#c33764);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.container{
    width:650px;
    background:white;
    padding:30px;
    border-radius:15px;
    box-shadow:0 10px 30px rgba(0,0,0,.3);
}

h1{
    text-align:center;
    color:#003366;
    margin-bottom:20px;
}

input{
    width:100%;
    padding:12px;
    margin:10px 0;
    font-size:16px;
}

button{
    width:100%;
    padding:15px;
    margin-top:15px;
    background:#003366;
    color:white;
    border:none;
    font-size:18px;
    cursor:pointer;
    border-radius:8px;
}

button:hover{
    background:#0055aa;
}

#bill{
    margin-top:25px;
    background:#eef7ff;
    padding:20px;
    border-radius:10px;
    display:none;
}

h2{
    color:#003366;
}

p{
    margin:8px 0;
    font-size:18px;
}
</style>

<script>
console.log("Billing Calculator Loaded");

function calculateBill(){

    var customer=document.getElementById("customer").value;
    let product=document.getElementById("product").value;
    let quantity=parseInt(document.getElementById("quantity").value);
    const price=parseFloat(document.getElementById("price").value);

    if(customer==""||product==""||isNaN(quantity)||isNaN(price)){
        alert("Please fill all details.");
        return;
    }

    let subtotal=quantity*price;

    let discount=0;

    if(subtotal>=5000)
        discount=subtotal*0.10;
    else if(subtotal>=3000)
        discount=subtotal*0.05;

    let afterDiscount=subtotal-discount;

    let gst=afterDiscount*0.18;

    const packing=50;

    let finalAmount=afterDiscount+gst+packing;

    const bill={
        customer,
        product,
        quantity,
        price,
        subtotal,
        discount,
        gst,
        packing,
        finalAmount
    };

    const{
        customer:c,
        product:p,
        quantity:q,
        price:pr,
        subtotal:s,
        discount:d,
        gst:g,
        packing:pk,
        finalAmount:f
    }=bill;

    document.getElementById("bill").style.display="block";

    document.getElementById("bill").innerHTML=`
    <h2>Shopping Invoice</h2>
    <p><strong>Customer :</strong> ${c}</p>
    <p><strong>Product :</strong> ${p}</p>
    <p><strong>Quantity :</strong> ${q}</p>
    <p><strong>Price :</strong> ₹${pr}</p>
    <hr>
    <p><strong>Subtotal :</strong> ₹${s.toFixed(2)}</p>
    <p><strong>Discount :</strong> ₹${d.toFixed(2)}</p>
    <p><strong>GST (18%) :</strong> ₹${g.toFixed(2)}</p>
    <p><strong>Packing Charges :</strong> ₹${pk}</p>
    <hr>
    <h2>Total Bill : ₹${f.toFixed(2)}</h2>
    `;

    console.log(`Customer ${c} purchased ${q} ${p}. Total Bill = ₹${f.toFixed(2)}`);
}
</script>

</head>

<body>

<div class="container">

<h1>🛒 Online Shopping Billing Calculator</h1>

<input type="text" id="customer" placeholder="Enter Customer Name">

<input type="text" id="product" placeholder="Enter Product Name">

<input type="number" id="quantity" placeholder="Enter Quantity">

<input type="number" id="price" placeholder="Enter Price Per Item">

<button onclick="calculateBill()">Generate Bill</button>

<div id="bill"></div>

</div>

</body>
</html>
