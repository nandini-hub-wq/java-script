<body>

<div class="container">

    <div class="header">
        <h1>🔎 Smart Text & Regex Analyzer</h1>
        <p>Email Validation • Data Extraction • Text Analysis</p>
    </div>

    <div class="student">
        <span>👩‍💻 Nandini Daharwal</span>
        <span>🎓 PRN: 24070521152</span>
    </div>

    <div class="content">

        <!-- EMAIL VALIDATION -->
        <div class="card">

            <h3>📧 Email Validation</h3>

            <label>Enter Email Address</label>

            <input
                type="text"
                id="email"
                placeholder="example@gmail.com">

            <button onclick="validateEmail()">
                Validate Email
            </button>

            <div id="emailResult" class="result">
                Enter an email address to check its validity.
            </div>

        </div>


        <!-- TEXT ANALYSIS -->
        <div class="card">

            <h3>📝 Text Analysis</h3>

            <label>Enter Your Text</label>

            <textarea
                id="textInput"
                placeholder="Example: Contact me at nandini@gmail.com or call 9876543210. Follow #Coding #JavaScript"></textarea>

            <button onclick="analyzeText()">
                Analyze Text
            </button>

            <div class="analysis-grid">

                <div class="box">
                    <h2 id="charCount">0</h2>
                    <p>Characters</p>
                </div>

                <div class="box">
                    <h2 id="wordCount">0</h2>
                    <p>Words</p>
                </div>

                <div class="box">
                    <h2 id="vowelCount">0</h2>
                    <p>Vowels</p>
                </div>

                <div class="box">
                    <h2 id="numberCount">0</h2>
                    <p>Numbers</p>
                </div>

            </div>

        </div>


        <!-- DATA EXTRACTION -->
        <div class="card">

            <h3>📊 Extracted Data</h3>

            <div class="result">
                <strong>Emails:</strong>
                <span id="emailsFound">None</span>

                <br>

                <strong>Phone Numbers:</strong>
                <span id="phonesFound">None</span>

                <br>

                <strong>Hashtags:</strong>
                <span id="hashtagsFound">None</span>

                <br>

                <strong>Uppercase Text:</strong>
                <span id="upperText">-</span>

                <br>

                <strong>Lowercase Text:</strong>
                <span id="lowerText">-</span>
            </div>

        </div>

    </div>

